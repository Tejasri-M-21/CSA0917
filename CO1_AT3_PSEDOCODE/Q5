ALGORITHM ArmstrongNumber
INPUT n
temp <- n
sum <- 0
count <- 0
WHILE temp != 0 DO
count <- count + 1
temp <- temp DIV 10
END WHILE
temp <- n
WHILE temp != 0 DO
digit <- temp MOD 10
sum <- sum + (digit count)
temp <- temp DIV 10
END WHILE
IF sum == n THEN
PRINT "The number is an Armstrong number"
ELSE
PRINT "The number is not an Armstrong number"
END IF
END ALGORITHM
