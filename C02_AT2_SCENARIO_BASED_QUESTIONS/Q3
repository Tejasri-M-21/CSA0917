import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] marks = new int[n];
        for (int i = 0; i < n; i++) {
            marks[i] = sc.nextInt();
        }
        int pass = 0, fail = 0;
        StringBuilder grades = new StringBuilder();
        for (int i = 0; i < n; i++) {
            int m = marks[i];
            String grade;
            if (m < 50) {
                fail++;
                grade = "Fail";
            } else {
                pass++;
                if (m >= 75) {
                    grade = "A";
                } else if (m >= 60) {
                    grade = "B";
                } else {
                    grade = "C";
                }
            }
            grades.append(grade);
            if (i != n - 1) grades.append(",");
        }
        System.out.println("Pass=" + pass + " Fail=" + fail);
        System.out.println("Grades=" + grades.toString());
    }
}
