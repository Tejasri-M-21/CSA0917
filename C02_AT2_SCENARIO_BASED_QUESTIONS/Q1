import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = 10;
        int[] marks = new int[n];
        for (int i = 0; i < n; i++) {
            marks[i] = sc.nextInt();
        }
        int highest = marks[0];
        int sum = 0;
        for (int i = 0; i < n; i++) {
            sum += marks[i];
            if (marks[i] > highest) {
                highest = marks[i];
            }
        }
        double average = (double) sum / n;
        int countAboveAverage = 0;
        for (int i = 0; i < n; i++) {
            if (marks[i] > average) {
                countAboveAverage++;
            }
        }
        System.out.println("Highest = " + highest);
        System.out.printf("Average = %.1f%n", average);
        System.out.println("Students Above Average = " + countAboveAverage);
    }
}
