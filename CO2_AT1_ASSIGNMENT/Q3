import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextLine()) {
            String word = sc.nextLine();
            char[] arr = word.toCharArray();
            Arrays.sort(arr); 
            for (int i = arr.length - 1; i >= 0; i--) {
                System.out.print(arr[i]);
                if (i != 0) {
                    System.out.print(" ");
                }
            }
        }
        sc.close();
    }
}
